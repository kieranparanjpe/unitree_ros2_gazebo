<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>unitree_keyboard_teleop</name>
  <version>0.0.1</version>
  <description>
    Hold-to-drive keyboard teleop publishing geometry_msgs/Twist on /cmd_vel. WASD drives the
    linear axes, the left/right arrows yaw. Robot-agnostic and simulator-agnostic - it only
    publishes a velocity command, so it drives the Gazebo stack and real hardware alike.
  </description>
  <maintainer email="kieran.paranjpe@mail.mcgill.ca">Kieran Paranjpe</maintainer>
  <license>TODO</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>geometry_msgs</depend>
  <!-- Plain C++ library, no nodes of its own. Decodes terminal escape sequences into KeyCode
       values (the arrow keys are ESC [ C / ESC [ D), owns the raw-mode termios switch, and
       restores the terminal on SIGINT. -->
  <depend>keyboard_handler</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
