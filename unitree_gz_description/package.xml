<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>unitree_gz_description</name>
  <version>0.0.1</version>
  <description>
    Generic bare-URDF to Gazebo/ros2_control URDF generator. Adding a new robot means adding
    one robots/&lt;name&gt;.yaml pointer file, not a new package.
  </description>
  <maintainer email="kieran.paranjpe@mail.mcgill.ca">Kieran Paranjpe</maintainer>
  <license>TODO</license>

  <!-- Deliberately minimal: generate_urdf.py imports only os, xml.etree and yaml. Everything
       that needs ROS or Gazebo lives in unitree_gz_bringup, so the policy packages can depend
       on this one without pulling in a simulator they may not have. -->
  <depend>python3-yaml</depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
